# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# Required for portfolio admin (itshassanahmed.com /admin)
PORTFOLIO_ADMIN_PASSWORD=your-strong-password-min-8-chars

# Optional: separate secret for signing admin sessions (recommended in production)
# If unset, derived from PORTFOLIO_ADMIN_PASSWORD
# PORTFOLIO_ADMIN_SESSION_SECRET=random-32-char-string

# Supabase (TrackHive)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs (Vercel Cron, etc.)
CRON_SECRET=

# PayPal (billing)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
